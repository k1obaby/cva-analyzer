<Window x:Class="CvaAnalyzer.Views.BackgroundMetadataWindow"
        xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        Title="Параметры фона" Height="400" Width="400" SizeToContent="Height" ResizeMode="NoResize">
    <Window.DataContext>
        <Binding Path="MetadataViewModel" RelativeSource="{RelativeSource AncestorType=Window}"/>
    </Window.DataContext>

    <Grid Margin="10">
        <Grid.RowDefinitions>
            <RowDefinition Height="Auto"/>
            <RowDefinition Height="Auto"/>
            <RowDefinition Height="Auto"/>
            <RowDefinition Height="Auto"/>
            <RowDefinition Height="Auto"/>
            <RowDefinition Height="Auto"/>
            <RowDefinition Height="Auto"/>
            <RowDefinition Height="Auto"/>
            <RowDefinition Height="Auto"/>
            <RowDefinition Height="Auto"/>
            <RowDefinition Height="Auto"/>
        </Grid.RowDefinitions>
        <Grid.ColumnDefinitions>
            <ColumnDefinition Width="120"/>
            <ColumnDefinition Width="*"/>
        </Grid.ColumnDefinitions>

        <TextBlock Text="Название образца:" Grid.Row="0" VerticalAlignment="Center"/>
        <TextBox x:Name="SampleNameBox" Grid.Column="1" Grid.Row="0"
                 Text="{Binding SampleName, UpdateSourceTrigger=PropertyChanged}"/>

        <TextBlock Text="Скорость развертки (мВ/с):" Grid.Row="1" VerticalAlignment="Center"/>
        <TextBox x:Name="ScanRateBox" Grid.Row="1" Grid.Column="1"
         Text="{Binding ScanRate, UpdateSourceTrigger=PropertyChanged}"
         PreviewTextInput="ScanRateBox_PreviewTextInput"
         DataObject.Pasting="ScanRateBox_Pasting">
            <TextBox.Style>
                <Style TargetType="TextBox">
                    <Setter Property="Validation.ErrorTemplate">
                        <Setter.Value>
                            <ControlTemplate>
                                <DockPanel LastChildFill="True">
                                    <Border BorderBrush="Red" BorderThickness="1">
                                        <AdornedElementPlaceholder/>
                                    </Border>
                                    <TextBlock Foreground="Red" Text="Введите число > 0" Margin="5,0,0,0"/>
                                </DockPanel>
                            </ControlTemplate>
                        </Setter.Value>
                    </Setter>
                </Style>
            </TextBox.Style>
        </TextBox>

        <TextBlock Text="Электролит:" Grid.Row="2" VerticalAlignment="Center"/>
        <TextBox x:Name="ElectrolyteBox"
                 Text="{Binding Electrolyte, UpdateSourceTrigger=PropertyChanged}"
                 Grid.Row="2" Grid.Column="1"/>

        <TextBlock Text="Рабочий электрод:" Grid.Row="3" VerticalAlignment="Center"/>
        <TextBox x:Name="WorkingElectrodeBox"
                 Text="{Binding WorkingElectrode, UpdateSourceTrigger=PropertyChanged}"
                 Grid.Row="3" Grid.Column="1"/>

        <TextBlock Text="Электрод сравнения:" Grid.Row="4" VerticalAlignment="Center"/>
        <TextBox x:Name="ReferenceElectrodeBox"
                 Text="{Binding ReferenceElectrode, UpdateSourceTrigger=PropertyChanged}"
                 Grid.Row="4" Grid.Column="1"/>

        <TextBlock Text="Атмосфера:" Grid.Row="5" VerticalAlignment="Center"/>
        <TextBox x:Name="AtmosphereBox"
                 Text="{Binding Atmosphere, UpdateSourceTrigger=PropertyChanged}"
                 Grid.Row="5" Grid.Column="1"/>

        <TextBlock Text="Ячейка:" Grid.Row="6" VerticalAlignment="Center"/>
        <TextBox x:Name="CellTypeBox"
                 Text="{Binding CellType, UpdateSourceTrigger=PropertyChanged}"
                 Grid.Row="6" Grid.Column="1"/>

        <TextBlock Text="Способ нанесения:" Grid.Row="7" VerticalAlignment="Center"/>
        <TextBox x:Name="DepositionMethodBox"
                 Text="{Binding DepositionMethod, UpdateSourceTrigger=PropertyChanged}"
                 Grid.Row="7" Grid.Column="1"/>

        <TextBlock Text="Освещение:" Grid.Row="8" VerticalAlignment="Center"/>
        <TextBox x:Name="IlluminationBox"
                 Text="{Binding Illumination, UpdateSourceTrigger=PropertyChanged}"
                 Grid.Row="8" Grid.Column="1"/>

        <Button Content="OK" Click="OkButton_Click" Grid.Row="9" Grid.ColumnSpan="2" Margin="0,10"/>
    </Grid>
</Window>